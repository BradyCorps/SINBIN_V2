{
  "name": "sinbin-v2",
  "version": "0.0.1",
  "private": true,
  "description": "SINBIN product repository — draft to release",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check": "npm run typecheck && npm run format:check && npm run lint && npm run test && npm run build && npm run build-storybook"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/nextjs-vite": "10.5.10",
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "prettier": "3.9.6",
    "storybook": "10.5.10",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "type": "module"
}
